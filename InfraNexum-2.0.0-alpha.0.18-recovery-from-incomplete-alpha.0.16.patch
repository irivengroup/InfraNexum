index 0000000000000000000000000000000000000000..702f36ba0c5f7fe44ed2caa6f527b76c12857b33
--- /dev/null
+++ b/src/components/core/workers/src/main/java/io/infranexum/core/workers/RetrySafety.java
@@ -0,0 +1,9 @@
+package io.infranexum.core.workers;
+
+/** Declares whether a failed or abandoned execution may be attempted again automatically. */
+public enum RetrySafety {
+    /** Handler is idempotent for the task idempotency key and may be retried. */
+    RETRY_SAFE,
+    /** Handler may have non-idempotent side effects and is never retried automatically. */
+    AT_MOST_ONCE
+}
diff --git a/src/components/core/workers/src/main/java/io/infranexum/core/workers/ShutdownReport.java b/src/components/core/workers/src/main/java/io/infranexum/core/workers/ShutdownReport.java
