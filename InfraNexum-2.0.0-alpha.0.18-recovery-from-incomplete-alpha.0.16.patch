+package io.infranexum.core.workers;
+
+/** Durable lifecycle state of a scheduled task. */
+public enum TaskStatus {
+    PENDING,
+    RUNNING,
+    SUCCEEDED,
+    FAILED,
+    CANCELLED;
+
+    public boolean terminal() {
