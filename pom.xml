<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.infranexum</groupId>
  <artifactId>infranexum-parent</artifactId>
  <version>2.0.0-alpha.0.45</version>
  <packaging>pom</packaging>
  <name>InfraNexum</name>
  <description>InfraNexum — Infrastructure Control &amp; Governance Platform</description>

  <modules>
    <module>src/components/core/contracts</module>
    <module>src/components/core/events</module>
    <module>src/components/core/workers</module>
    <module>src/components/core/capabilities</module>
    <module>src/components/core/entitlements</module>
    <module>src/components/core/audit</module>
    <module>src/components/adapters/jdbc</module>
    <module>src/applications/server</module>
  </modules>

  <properties>
    <java.version>25</java.version>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <spring-boot.version>4.1.0</spring-boot.version>
    <spring-modulith.version>2.1.0</spring-modulith.version>
    <jacoco.version>0.8.15</jacoco.version>
    <maven.compiler.version>3.15.0</maven.compiler.version>
    <maven.surefire.version>3.6.0-M1</maven.surefire.version>
    <maven.enforcer.version>3.6.3</maven.enforcer.version>
    <infranexum.surefire.failIfNoTests>true</infranexum.surefire.failIfNoTests>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework.modulith</groupId>
        <artifactId>spring-modulith-bom</artifactId>
        <version>${spring-modulith.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <!-- Short source roots are intentional: they preserve Java package paths while
         keeping repository-relative paths safely below the Windows extraction budget. -->
    <sourceDirectory>main</sourceDirectory>
    <resources>
      <resource><directory>resources</directory></resource>
    </resources>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven.compiler.version}</version>
          <configuration>
            <release>${maven.compiler.release}</release>
            <parameters>true</parameters>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven.surefire.version}</version>
          <configuration>
            <useModulePath>false</useModulePath>
            <failIfNoTests>${infranexum.surefire.failIfNoTests}</failIfNoTests>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>${jacoco.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>${maven.enforcer.version}</version>
        <executions>
          <execution>
            <id>enforce-toolchain</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <requireJavaVersion><version>[25,26)</version></requireJavaVersion>
                <requireMavenVersion><version>[3.9.16,4)</version></requireMavenVersion>
                <requireReleaseDeps><message>Snapshot dependencies are forbidden.</message></requireReleaseDeps>
                <banDuplicatePomDependencyVersions/>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
