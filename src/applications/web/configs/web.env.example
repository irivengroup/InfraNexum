# Public Web runtime configuration. Never place secrets in these variables.
INFRANEXUM_WEB_LISTEN_ADDRESS=0.0.0.0:8080
INFRANEXUM_WEB_API_BASE_URL=/api
INFRANEXUM_WEB_ENVIRONMENT=production
INFRANEXUM_WEB_STATIC_ROOT=./public
INFRANEXUM_WEB_SHUTDOWN_TIMEOUT_MS=20000
INFRANEXUM_ARCHITECTURE_BASELINE=2.0.0-draft.21
INFRANEXUM_WEB_ORGANIZATION_FOUNDATION_ENABLED=false
INFRANEXUM_WEB_LOCAL_AUTH_ENABLED=true
INFRANEXUM_WEB_IDENTITY_ACCESS_ENABLED=true
INFRANEXUM_WEB_ADVANCED_AUTHORIZATION_ENABLED=true

INFRANEXUM_WEB_RSOT_CORE_ENABLED=false
