{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:infranexum:schema:activation-trust-store:v1",
  "title": "InfraNexum activation trust store",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "keys"],
  "properties": {
    "schema": {
      "const": "infranexum.activation-trust-store/v1"
    },
    "keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key_id", "algorithm", "public_key_x509_base64", "valid_from", "valid_until"],
        "properties": {
          "key_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "algorithm": {
            "const": "Ed25519"
          },
          "public_key_x509_base64": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "valid_from": {
            "type": "string",
            "format": "date-time"
          },
          "valid_until": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
