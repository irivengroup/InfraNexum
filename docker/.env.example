# Optional host-side overrides. Secrets are generated inside a private named volume.
INFRANEXUM_VERSION=2.0.0-alpha.0.39
INFRANEXUM_SERVER_PUBLISHED_PORT=8080
INFRANEXUM_POSTGRES_PUBLISHED_PORT=5432
INFRANEXUM_SERVER_INSTANCE_ID=server-compose-1
INFRANEXUM_LOG_FORMAT=ecs
INFRANEXUM_ENVIRONMENT=local
INFRANEXUM_SCHEDULING_POOL_SIZE=2
INFRANEXUM_SCHEDULING_SHUTDOWN_TIMEOUT=PT10S
INFRANEXUM_WORKERS_ENABLED=true
INFRANEXUM_WORKERS_CONCURRENCY=2
INFRANEXUM_WORKERS_POLL_INTERVAL=PT0.5S
INFRANEXUM_WORKERS_LEASE_DURATION=PT30S
INFRANEXUM_WORKERS_HEARTBEAT_INTERVAL=PT10S
INFRANEXUM_WORKERS_SHUTDOWN_TIMEOUT=PT15S
INFRANEXUM_WORKERS_MAXIMUM_ATTEMPTS=5
INFRANEXUM_WORKERS_INITIAL_RETRY_DELAY=PT1S
INFRANEXUM_WORKERS_MAXIMUM_RETRY_DELAY=PT1M
INFRANEXUM_WORKERS_JITTER_RATIO=0.2
