{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.infranexum.invalid/activation-manifest-v2.schema.json",
  "title": "InfraNexum activation manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "activation_id", "customer", "installation", "profile", "allocation_tier",
    "catalog_version", "host_limit", "capabilities", "quotas", "valid_from", "valid_until",
    "grace_period_days", "issued_at", "issuer", "sequence", "key_id", "signature"
  ],
  "properties": {
    "schema": {"const": "infranexum.activation-manifest/v2"},
    "activation_id": {"type": "string", "format": "uuid"},
    "customer": {
      "type": "object", "additionalProperties": false,
      "required": ["customer_id", "legal_name"],
      "properties": {
        "customer_id": {"type": "string", "minLength": 1, "maxLength": 255},
        "legal_name": {"type": "string", "minLength": 1, "maxLength": 255}
      }
    },
    "installation": {
      "type": "object", "additionalProperties": false,
      "required": ["installation_id", "fingerprint_version", "fingerprint"],
      "properties": {
        "installation_id": {"type": "string", "format": "uuid"},
        "fingerprint_version": {"type": "string", "pattern": "^v[1-9][0-9]*$"},
        "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "profile": {"enum": ["pro", "enterprise"]},
    "allocation_tier": {"enum": ["standard", "advanced", "ultimate"]},
    "catalog_version": {"type": "string", "minLength": 1},
    "host_limit": {"type": "integer", "minimum": 0},
    "capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "quotas": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "valid_from": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "valid_until": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "grace_period_days": {"const": 30},
    "issued_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "issuer": {"type": "string", "minLength": 1},
    "sequence": {"type": "integer", "minimum": 1},
    "key_id": {"type": "string", "minLength": 1},
    "signature": {"type": "string", "contentEncoding": "base64"}
  },
  "allOf": [
    {"if": {"properties": {"profile": {"const": "pro"}}}, "then": {"properties": {"allocation_tier": {"enum": ["standard", "advanced"]}}}},
    {"if": {"properties": {"profile": {"const": "enterprise"}}}, "then": {"properties": {"allocation_tier": {"enum": ["standard", "ultimate"]}}}}
  ]
}
